{
  "productName": "Yio Packer",
  "version": "0.1.0",
  "identifier": "com.yio.packer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "Yio",
        "width": 800,
        "height": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Yio packer — HTML/CSS workspace builder",
    "longDescription": "Standalone GUI tool for the Yio cross-engine game UI framework. Import HTML/CSS workspaces, configure packaging options, and produce optimized .pkg.bin bundles with texture atlases.",
    "publisher": "Yio",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
